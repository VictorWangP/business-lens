SECRET_KEY=replace-with-a-random-secret
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_KEY=
# SQLite 路径默认位于项目 storage-v2/app.db，无需配置数据库服务
TASK_BACKEND=database
CORS_ORIGINS=["http://localhost:5174"]
AGENT_MAX_STEPS=64
AGENT_MAX_TOOL_CALLS=128
AGENT_TIMEOUT=900

AGENT_MAX_TOTAL_TOKENS=0
# Optional OpenTelemetry collector base URL, e.g. http://collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional LangSmith tracing. Keep the API key in the private backend/.env file.
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag-langgraph

# 可选：语音识别服务（未配置时明确返回不可用）
# 百炼 ASR；可留空以复用“模型配置”中默认对话模型的百炼地址和密钥。
STT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_API_KEY=
STT_MODEL=qwen3-asr-flash

# 可见输入约 100K 时清理已完成历史中的旧工具正文；约 200K 时摘要更早历史。
AGENT_TOOL_PRUNE_TRIGGER_TOKENS=100000
AGENT_SUMMARY_TRIGGER_TOKENS=200000
AGENT_SUMMARY_KEEP_TOKENS=32000
# Model-visible tool output limit; full results remain in the evidence archive.
AGENT_TOOL_OUTPUT_TOKENS=3000
AGENT_CONTEXT_SAFETY_TOKENS=2048
AGENT_RECENT_TOOL_RESULTS=8
AGENT_MAX_IDENTICAL_TOOL_CALLS=3
# Model-specific capacity is resolved automatically; optional overrides above are application caps.
AGENT_DEFAULT_CONTEXT_TOKENS=131072
AGENT_MAX_OUTPUT_TOKENS=8192
AGENT_COMPACTION_BUFFER_RATIO=0.1
