SECRET_KEY=replace-with-a-random-secret
# Generate: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_KEY=
# SQLite 路径默认位于项目 storage-v2/app.db，无需配置数据库服务
TASK_BACKEND=database
CORS_ORIGINS=["http://localhost:5174"]
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=16
AGENT_TIMEOUT=180

STORAGE_BACKEND=local
# Optional S3-compatible storage; AWS credentials may also come from the deployment role.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# Optional reranker; accepts model/query/documents/top_n and returns results[index,relevance_score].
RERANK_API_URL=
RERANK_MODEL=
RERANK_API_KEY=
# Cosine similarity cutoff for vector recall; lexical hits are evaluated separately.
RETRIEVAL_MIN_SIMILARITY=0.25
AGENT_MAX_TOTAL_TOKENS=64000
# Optional OpenTelemetry collector base URL, e.g. http://collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# 可选：语音识别服务（未配置时明确返回不可用）
# 百炼 ASR；可留空以复用“模型配置”中默认对话模型的百炼地址和密钥。
STT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_API_KEY=
STT_MODEL=qwen3-asr-flash

AGENT_CONTEXT_TOKENS=32768
AGENT_SUMMARY_TRIGGER_TOKENS=18000
AGENT_SUMMARY_KEEP_TOKENS=6000
