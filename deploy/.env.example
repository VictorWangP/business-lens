# Docker Compose interpolation settings. Keep the project name/volume stable.
IMAGE_TAG=local
# Match the Linux server CPU: linux/amd64 for x86_64, linux/arm64 for aarch64.
DOCKER_PLATFORM=linux/amd64
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# Generated by scripts/deploy.sh init. Preserve these across upgrades/restores.
SECRET_KEY=
CREDENTIAL_KEY=
CORS_ORIGINS=[]
AGENT_WORKER_CONCURRENCY=5
AGENT_TIMEOUT=900
AGENT_MAX_STEPS=64
AGENT_MAX_TOOL_CALLS=128
AGENT_MAX_TOTAL_TOKENS=0
LANGSMITH_TRACING=false
STT_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
STT_API_KEY=
STT_MODEL=qwen3-asr-flash
